# Copy this file to `.env` (in the same folder) and fill in your values.
# `.env` is gitignored — credentials never get committed.

# Neon connection string
# Get this from your Neon dashboard → Connection Details → SQLAlchemy
# Important: use the `postgresql+psycopg://` prefix (not `postgresql://`)
# so SQLAlchemy picks the psycopg v3 driver.
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require
